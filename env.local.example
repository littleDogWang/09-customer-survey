# Public Agora App ID: required by the Next.js browser build and server runtime.
NEXT_PUBLIC_AGORA_APP_ID=

# Server-runtime secret: never expose to the browser, Git or Docker build arguments.
NEXT_AGORA_APP_CERTIFICATE=

# Optional server-only configuration: public HTTPS origin of this same app.
# Leave unset for default conversation. Cloud reachability must be verified.
# TOP_TEN_SCENARIO_TOOL_BASE_URL=https://your-app.example.com

# Optional server path: Optional writable persistent directory for survey results; defaults to .scenario-data.
# TOP_TEN_DATA_DIR=/app/.scenario-data
