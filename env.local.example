# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional: this app's public HTTPS origin for Agent result submission.
# TOP_TEN_SCENARIO_TOOL_BASE_URL=https://your-app.example.com
# Optional: writable durable data directory (default .scenario-data).
# TOP_TEN_DATA_DIR=/path/to/persistent/data
